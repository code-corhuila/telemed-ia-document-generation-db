# =========================================================================
# Variables required by document-generation-db-migrate.
#
# These are NOT defined in this repo. They come from the infrastructure
# env file of telemed-ia-infra-postgres:
#     env/dev.env   (development)
#     env/qa.env    (qa)
#     env/main.env  (main)
#
# This file only documents which variables must exist there. Do not
# commit real secrets.
# =========================================================================

# Shared PostgreSQL database name (defined in infra)
PG_DATABASE=telemed_ia

# Password for the document_generation_app role (defined in infra)
DOCUMENT_GENERATION_APP_PASSWORD=change-me

# Optional override of the application user name.
# Default: document_generation_app
# DOCUMENT_GENERATION_APP_USER=document_generation_app

